{
  "name": "nudge-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "imports": {
    "@nudge/shared": "./packages/shared/src/index.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types apps/api/src/server.ts",
    "test": "node --experimental-strip-types --test ./packages/shared/test/*.test.ts ./apps/api/test/*.test.ts"
  }
}

